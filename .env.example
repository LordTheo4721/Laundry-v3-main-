# Server Configuration
PORT=8080
NODE_ENV=production

# CORS: comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com

# Security
# Generate a cryptographically secure random string for JWT signing
# Use: openssl rand -base64 32
JWT_SECRET=replace_with_a_private_random_secret

# Admin Credentials
# Change this to a strong password in production
# Use: openssl rand -base64 32
ADMIN_PASSWORD=replace_with_a_private_password

# Database: MySQL / MariaDB only (XAMPP locally, Hostinger MySQL in production)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=laundry
DB_SSL=false
DB_POOL_SIZE=10

# Machine Settings
# Default runtime for machines in seconds (2700 = 45 minutes)
MACHINE_DEFAULT_TIME=2700

# Email Configuration (SMTP)
# For Gmail, use app password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Laundry Service <your-email@gmail.com>

# Disable email notifications (set to 'true' to disable, 'false' to enable)
EMAIL_DISABLED=false

# Frontend (Vite) - set when deploying the React app separately from the API
# VITE_API_URL=https://api.happywashlaundry.online
